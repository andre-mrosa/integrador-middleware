    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>Trigénius</Company>
    <Product>Integrador</Product> <!-- TODO: nome do produto (ex: Integrador CRM-ERP) -->
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
