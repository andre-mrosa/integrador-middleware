  <data name="hccStatus.HtmlTemplate.Styles" xml:space="preserve">
    <value>.cards {
	display: flex;
	flex-direction: row;
	height: 100%;
}
.card {
	flex-grow: 1;
	flex-basis: 0px;
	display: flex;
	flex-direction: column;
	margin-right: 12px;
	padding: 14px 16px;
	border-radius: 8px;
	border-width: 1px;
	border-style: solid;
	border-color: @HideSelection;
	background-color: @Window;
}
.last {
	margin-right: 0px;
}
.label {
	color: @DisabledText;
	font-size: 9pt;
}
.value {
	margin-top: 6px;
	font-size: 13pt;
	font-weight: bold;
	color: @WindowText;
}
.hint {
	margin-top: 4px;
	color: @DisabledText;
	font-size: 8.25pt;
}
.ok {
	color: @Success;
}
.warn {
	color: @Warning;
}
.error {
	color: @Danger;
}</value>
  </data>
  <data name="hccStatus.HtmlTemplate.Template" xml:space="preserve">
    <value>&lt;div class="cards"&gt;
	&lt;div class="card"&gt;
		&lt;div class="label"&gt;${SourceLabel}&lt;/div&gt;
		&lt;div id="sourceValue" class="value"&gt;${SourceValue}&lt;/div&gt;
		&lt;div class="hint"&gt;Ligação de origem dos dados&lt;/div&gt;
	&lt;/div&gt;
	&lt;div class="card"&gt;
		&lt;div class="label"&gt;${TargetLabel}&lt;/div&gt;
		&lt;div id="targetValue" class="value"&gt;${TargetValue}&lt;/div&gt;
		&lt;div class="hint"&gt;Ligação de destino dos dados&lt;/div&gt;
	&lt;/div&gt;
	&lt;div class="card"&gt;
		&lt;div class="label"&gt;Última execução&lt;/div&gt;
		&lt;div class="value"&gt;${LastRunValue}&lt;/div&gt;
		&lt;div id="lastRunHint" class="hint"&gt;${LastRunHint}&lt;/div&gt;
	&lt;/div&gt;
	&lt;div class="card last"&gt;
		&lt;div class="label"&gt;Próxima execução&lt;/div&gt;
		&lt;div class="value"&gt;${NextRunValue}&lt;/div&gt;
		&lt;div class="hint"&gt;${NextRunHint}&lt;/div&gt;
	&lt;/div&gt;
&lt;/div&gt;</value>
  </data>
