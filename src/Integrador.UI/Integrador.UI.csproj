<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Integrador.UI</RootNamespace>
    <!-- TODO: nome do executável (ex: Integrador CRM-ERP) -->
    <AssemblyName>Integrador</AssemblyName>
    <ApplicationIcon>FAvico_fundo_preto.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="FAvico_fundo_preto.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Win.BonusSkins" />
    <PackageReference Include="DevExpress.Win.Design" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Integrador.Common\Integrador.Common.csproj" />
    <ProjectReference Include="..\Modules\Integrador.Source\Integrador.Source.csproj" />
    <ProjectReference Include="..\Modules\Integrador.Integration\Integrador.Integration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="SplashScreen1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\LogDetailForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UserControls\HomeUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UserControls\ConfigurationsUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UserControls\LogsUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="UserControls\SchedulerUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
